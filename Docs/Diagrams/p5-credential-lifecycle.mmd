flowchart TB
    classDef secret fill:#FFF4D6,stroke:#B7791F,color:#5F370E,stroke-width:2px
    classDef protected fill:#E9F8EF,stroke:#247A45,color:#153B24,stroke-width:2px
    classDef exposed fill:#FDECEC,stroke:#C53030,color:#63171B,stroke-width:2px
    classDef process fill:#EAF4FF,stroke:#1769AA,color:#102A43

    subgraph ScriptPath["Literal password in a Terminal command or script"]
        direction LR
        Typed["Typed or saved password"]:::secret
        History["Shell history or script file<br/>may retain plaintext"]:::exposed
        Args["Process arguments<br/>may be inspectable while running"]:::exposed
        Typed --> History --> Args
    end

    subgraph AppPath["P5 Command Lab"]
        direction LR
        Entry["Password entered once"]:::secret
        Keychain["macOS Keychain<br/>generic-password item"]:::protected
        Runtime["Loaded only for a live run"]:::process
        Redacted["Preview and transcript<br/>redacted by default"]:::protected
        Entry --> Keychain --> Runtime
        Runtime -. "display" .-> Redacted
    end

    Runtime -->|"remote awsock argument:<br/>transient process-argument exposure remains"| Transport["P5 transport"]:::process
    Args --> Transport
    Runtime -->|"REST Authorization header"| Transport

    Transport --> HTTP["HTTP: credentials and payload<br/>not transport-encrypted"]:::exposed
    Transport --> HTTPS["HTTPS: TLS protects data in transit<br/>when server identity is verified"]:::protected
    Transport --> AWSOCK["awsock: TCP documented;<br/>TLS is not documented in the CLI manual"]:::secret
